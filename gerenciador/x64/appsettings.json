{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.ElasticSearch",
      "Serilog.Sinks.Console",
      "Serilog.Exceptions"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "SkyInfo.Crva.Detran.Digitaliza.Monitor.GerenciadorDeVersões"
    },
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "System": "Debug"
      }
    }
  },
  "ConfiguracaoDoGerenciadorDeVersoes": {
    "RepositorioGitHub": "SkyInformatica/CRVA.Monitor.Instalacao",
    "IntervaloParaChecagemDeVersoesEmMilissegundos": 10000
  },
  "ConfiguracaoDoMonitor": {
    "Credenciais": {
      "Email": "EMAIL_DO_USUARIO",
      "Senha": "SENHA_DO_USUARIO",
      "Organizacao": "ORGANIZACAO_DO_USUARIO"
    },
    "UriBase": "https://skydigitalliza-servidor.azurewebsites.net",
    "DiretorioDeDocumentos": "DIRETORIO_DE_DOCUMENTOS",
    "SimularEnvio": false
  }
}