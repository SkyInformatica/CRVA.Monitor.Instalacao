{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "ConfiguraçãoGeral": {
    "UrlBase": "https://skydigitalliza-servidor.skyinfo.cc",
    "TimeoutHttpPadrão": "00:01:00"
  },
  "ConfiguraçãoDeAutenticação": {
    "Email": "EMAIL_DO_USUARIO",
    "Senha": "SENHA_DO_USUARIO",
    "OrganizaçãoId": "ORGANIZACAO_DO_USUARIO"
  },
  "ConfiguraçãoDeMonitoração": {
    "TempoDeEsperaParaProcessarArquivo": "00:00:10",
    "DiretórioDeMonitoração": "Documentos",
    "ArquivoDoArmazenamentoDeRegistros": "Armazenamento/registros.db"
  },
  "ConfiguraçãoDeEnvioDeDocumentos": {
    "MáximoDeTentativasDeEnvio": 10,
    "TamanhoLimitePorPáginaEmBytes": 10000000,
    "LimiteDeProcessamentosSimultâneos": 10,
    "SimularEnvio": true
  }
